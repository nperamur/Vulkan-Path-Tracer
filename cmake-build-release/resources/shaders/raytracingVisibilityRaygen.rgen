#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) uniform sampler2D depthBuffer;
layout(set = 0, binding = 2) uniform sampler2D visibilityBuffer;
layout(set = 0, binding = 4, rgba16f) uniform image2D storageImage;
layout(set = 0, binding = 3) uniform sampler2D normalBuffer;

struct RayPayload {
    vec3 hitColor;
    float distance;
    uint materialIndex;
};

layout(set = 1, binding = 0) uniform LightUBO {
    vec4 position;
    vec4 color;
    int frameCount;
} lightData;

float hash(vec2 uv, uint seed) {
    uint x = floatBitsToUint(uv.x);
    uint y = floatBitsToUint(uv.y);

    uint h = x ^ (y + 0x9e3779b9U + (x << 6) + (x >> 2)) ^ seed;
    h ^= h >> 16;
    h *= 0x7feb352dU;
    h ^= h >> 15;
    h *= 0x846ca68bU;
    h ^= h >> 16;

    return float(h & 0x007fffffU) / float(0x00800000U);
}

vec2 getRand2(vec2 uv, uint frameCount) {
    float r1 = hash(uv, frameCount);
    float r2 = hash(uv, frameCount + 1234567u);
    return vec2(r1, r2);
}



struct Material {
    vec4 color;
    float diffuseAlbedo;
};

layout(std430, set = 0, binding = 5) buffer Materials {
    Material materialData[];
} materials;

layout(set = 1, binding = 1) uniform InverseViewProj {
    mat4 invViewMatrix;
    mat4 invProjMatrix;
} inverseViewProj;

layout(location = 0) rayPayloadEXT RayPayload rayPayload;

const float PI = 3.14159265359;
const int NUM_MAX_BOUNCES = 1;
const int NUM_CANDIDATES = 6;


//BRDF Calculation
float getDiffuseBRDF(Material material) {
    return material.diffuseAlbedo / PI;
}


//Lamberts Cosine Law. Gives us differential irradience ie. light coming in from one direction
float calculateCosineIntegrand(Material material, vec3 normal, vec3 incomingLightDir) {
    return getDiffuseBRDF(material) * max(0, dot(normal, incomingLightDir));
}

float getDiffuseWeight(Material material, vec3 normal, vec3 dir, float integrand) {
    float pdf = max(0, dot(normal, dir));
    return integrand / (pdf + 0.00001);
}

vec3 getRandomRayDir(vec2 rand, vec3 normal) {
    float r = sqrt(rand.x);
    float theta = 2 * PI * rand.y;

    //converting to polar
    float x = r * sin(theta);
    float y = r * cos(theta);
    float z = sqrt(max(1 - rand.x, 0.0));

    vec3 localVec = vec3(x, y, z);

    vec3 helper = (abs(normal.z) < 0.999) ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 tbn = mat3(tangent, bitangent, normal);

    return tbn * localVec;

}

void main() {
    //Remove TerminateOnFirstHitEXT on GI
    uint rayFlags = gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT;

    float tMin = 0.1;
    float tMax = 1000.0f;

    const ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
    float depth = texelFetch(depthBuffer, pixelCoords, 0).r;
    vec2 uv = vec2(gl_LaunchIDEXT.xy + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec4 ndcPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 origin = inverseViewProj.invViewMatrix * (inverseViewProj.invProjMatrix * ndcPos);
    origin /= origin.w;

    vec3 normal = normalize(texelFetch(normalBuffer, pixelCoords, 0).rgb);


    //use normalize(lightData.position - origin).xyz, for shadows
    traceRayEXT(
        topLevelAS,
        rayFlags,
        0xFF,
        0,
        0,
        0,
        origin.xyz,
        tMin,
        getRandomRayDir(getRand2(uv, lightData.frameCount), normal),
        tMax,
        0
    );

    //imageStore(storageImage, pixelCoords, vec4(rayPayload.hitColor, 1.0));
    if (rayPayload.distance < 0) {
        imageStore(storageImage, pixelCoords, vec4(1));
        return;
    }
    //imageStore(storageImage, pixelCoords, materials.materialData[rayPayload.materialIndex].color);
    imageStore(storageImage, pixelCoords, materials.materialData[int(texelFetch(visibilityBuffer, pixelCoords, 0).r)].color);



}