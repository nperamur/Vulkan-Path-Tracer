#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "raytracingUtils.glsl"

struct RayPayload {
    vec3 throughput;
    uint normal;
    vec3 accumulation;
    uint pathInfo;
    float distance;
    float mediumDist;
    float bsdfPDF;
    float lobePDF;
    uint randState;
    uint coneData;
    uint nextRayDir;
    int16_t currentMedium;
    int16_t outerIorId;
};


//TODO: add medium dist array for exit into outer medium
uint initRandState(ivec2 pixelCoords, uint frameCount) {
    uint x = uint(pixelCoords.x);
    uint y = uint(pixelCoords.y);
    uint h = x ^ (y * 0x9e3779b9U) ^ (frameCount * 0x85ebca6bU);
    h ^= h >> 16;
    h *= 0x7feb352dU;
    h ^= h >> 15;
    h *= 0x846ca68bU;
    h ^= h >> 16;
    if (h == 0u) h = 1u;
    return h;
}


layout(location = 0) rayPayloadEXT RayPayload rayPayload;

int interiorList[NUM_MAX_BOUNCES];
float mediumList[NUM_MAX_BOUNCES];
int interiorListSize = 0;



void pushId(int materialId) {
    if (interiorListSize >= NUM_MAX_BOUNCES) return;
    interiorList[interiorListSize] = materialId;
    mediumList[interiorListSize] = 0;
    interiorListSize++;
}

int findId(int materialId) {
    for (int i = 0; i < interiorListSize; i++) {
        if (interiorList[i] == materialId) {
            return interiorList[i];
        }
    }
    return -1;
}

float peekMediumList() {
    if (interiorListSize == 0) return -1;
    return mediumList[interiorListSize - 1];
}

int peekId() {
    if (interiorListSize == 0) return -1;
    return interiorList[interiorListSize - 1];
}

void clearInteriorList() {
    for (int i = 0; i < interiorListSize; i++) {
        interiorList[i] = 0;
        mediumList[i] = 0;
    }
    interiorListSize = 0;
}


void deleteId(int materialId) {
    if (interiorListSize == 0) return;
    int tempList[NUM_MAX_BOUNCES];
    float tempMedium[NUM_MAX_BOUNCES];
    int tempListSize = 0;

    for (int i = 0; i < interiorListSize; i++) {
        if (interiorList[i] != materialId) {
            tempList[tempListSize] = interiorList[i];
            tempMedium[tempListSize] = mediumList[i];
            tempListSize++;
        }
    }
    clearInteriorList();
    interiorListSize = tempListSize;
    for (int i = 0; i < interiorListSize; i++) {
        interiorList[i] = tempList[i];
        mediumList[i] = tempMedium[i];
    }

}

vec3 getRayDirFromPixel(ivec2 pixelCoords) {
    vec2 uv = pixelCoords / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 rayClip = vec4(ndc, 1.0, 1.0);
    vec4 rayDirWorld = inverseViewProj.invViewMatrix * (inverseViewProj.invProjMatrix * rayClip);
    return normalize(rayDirWorld.xyz / rayDirWorld.w - lightData.playerPos.xyz);

}

void main() {
    const ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
    vec3 lightSum = vec3(0.0);
    vec3 cameraPosition = lightData.playerPos.xyz;
    for (int n = 0; n < NUM_SAMPLES_PER_PIXEL; n++) {
        clearInteriorList();
        float tMin = 0.001;
        float tMax = 1000.0f;

        rayPayload.distance = -1.0f;
        uint randState = initRandState(pixelCoords, pushConstants.frameCount + uint(n * 97));
        rayPayload.throughput = vec3(1.0f);
        rayPayload.currentMedium = int16_t(-1);
        rayPayload.outerIorId = int16_t(-1);
        rayPayload.mediumDist = 0;
        rayPayload.bsdfPDF = 0;
        rayPayload.lobePDF = 0;


        vec2 jitter = randFloat2(randState);
        vec2 uv = vec2(pixelCoords + jitter) / vec2(gl_LaunchSizeEXT.xy);
        vec2 ndc = uv * 2.0 - 1.0;
        vec4 rayClip = vec4(ndc, 1.0, 1.0);
        vec4 rayDirWorld = inverseViewProj.invViewMatrix * (inverseViewProj.invProjMatrix * rayClip);
        vec3 view = rayDirWorld.xyz / rayDirWorld.w;
        vec3 rayDir = normalize(view - cameraPosition);

        vec3 dxDir = getRayDirFromPixel(ivec2(pixelCoords.x + 1, pixelCoords.y));
        vec3 dyDir = getRayDirFromPixel(ivec2(pixelCoords.x, pixelCoords.y + 1));
        float alpha = max(acos(clamp(dot(rayDir, dxDir), -1.0, 1.0)),
                          acos(clamp(dot(rayDir, dyDir), -1.0, 1.0)));

        rayPayload.coneData = packHalf2x16(vec2(0, 2.0 * tan(min(alpha, PI * 0.5 - 1e-4) * 0.5)));
        rayPayload.accumulation = vec3(0.0f);
        rayPayload.randState = randState;
        rayPayload.pathInfo = 0;


        traceRayEXT(
           topLevelAS,
           gl_RayFlagsOpaqueEXT,
           0xFF, 0, 0, 0,
           cameraPosition, tMin,
           rayDir, tMax, 0
        );
        float t = rayPayload.distance;
        if (t < 0.0001) {
            float cosDir = cos(directionalLightAngularRadius);
            float sampleDiff = dot(rayDir, normalize(lightData.position).xyz);
            if (sampleDiff > cosDir && length(lightData.color.rgb) > 0) {
                lightSum += lightIntensity * lightData.color.rgb * SUN_RADIANCE;
            }
            lightSum += skyColor * SKY_RADIANCE * SKY_MULTIPLIER;
            continue;
        }
        vec3 origin = cameraPosition + rayDir * t;
        rayDir = octDecode(unpackSnorm2x16(rayPayload.nextRayDir));
        //if (dot(rayDir, normal) <= 0.0 && material.transmissionFactor == 0) throughput = vec3(0.0f);
        uint stackOp = getStackOp(rayPayload.pathInfo);
        if (stackOp == OP_PUSH && rayPayload.currentMedium >= 0) {
            pushId(int(rayPayload.currentMedium));
            rayPayload.mediumDist = 0.0f;
        }

        if (stackOp == OP_DELETE) {
            rayPayload.currentMedium = int16_t(-1);
            rayPayload.outerIorId = int16_t(-1);
        }

        if (rayPayload.throughput == vec3(0)) {
           lightSum += rayPayload.accumulation;
           continue;
        }
        for (int i = 0; i < NUM_MAX_BOUNCES; i++) {
            if (rayPayload.throughput == vec3(0)) {
                break;
            }
            rayPayload.pathInfo = setBounceCount(rayPayload.pathInfo, getBounceCount(rayPayload.pathInfo) + 1);
            vec3 prevOrigin = origin.xyz;
            vec3 normal = octDecode(unpackSnorm2x16(rayPayload.normal));
            traceRayEXT(
                topLevelAS,
                gl_RayFlagsOpaqueEXT,
                0xFF,
                0,
                0,
                0,
                origin.xyz,
                tMin,
                rayDir,
                tMax,
                0
            );

            if (rayPayload.distance < 0) {
                float cosDir = cos(directionalLightAngularRadius);
                float sampleDiff = dot(rayDir, normalize(lightData.position).xyz);
                float misWeight = 1.0f;
                float multiplier = 1.0f;
                if (sampleDiff > cosDir && length(lightData.color.rgb) > 0) {
                     float directionalLightSolidAngleWeight = SUN_RADIANCE * calculateSolidAngleFromAngularRadius(directionalLightAngularRadius) / getLightSelectionWeightSum(prevOrigin, normal, getStackOp(rayPayload.pathInfo) != 0);
                     float lightPDF = (1 / calculateSolidAngleFromAngularRadius(directionalLightAngularRadius)) * directionalLightSolidAngleWeight;
                     if (getPrevBounceMis(rayPayload.pathInfo)) {
                       misWeight = rayPayload.bsdfPDF / (rayPayload.bsdfPDF + lightPDF);
                       multiplier = rayPayload.lobePDF / rayPayload.bsdfPDF;
                     }
                     rayPayload.accumulation += lightIntensity * lightData.color.rgb * SUN_RADIANCE * rayPayload.throughput * multiplier * misWeight;
                } else {
                     rayPayload.accumulation += skyColor * rayPayload.throughput * SKY_RADIANCE;
                }
                break;
            }
            if (rayPayload.throughput == vec3(0.0f)) break;
            origin += rayDir * rayPayload.distance;
            rayDir = octDecode(unpackSnorm2x16(rayPayload.nextRayDir));
            if (interiorListSize > 0) {
                mediumList[interiorListSize - 1] = rayPayload.mediumDist;
            }
            stackOp = getStackOp(rayPayload.pathInfo);
            if (stackOp == OP_PUSH && rayPayload.currentMedium >= 0) {
                pushId(int(rayPayload.currentMedium));
                rayPayload.mediumDist = 0.0f;
            }
            if (stackOp == OP_DELETE && findId(int(rayPayload.currentMedium)) >= 0) {
                float dist = 0;
                if (interiorListSize > 0) {
                    dist = mediumList[interiorListSize - 1];
                }
                deleteId(int(rayPayload.currentMedium));
                rayPayload.currentMedium = int16_t(peekId());
                if (rayPayload.currentMedium >= 0) {
                    if (interiorListSize > 0) {
                        rayPayload.mediumDist = mediumList[interiorListSize - 1];
                    }
                    deleteId(int(rayPayload.currentMedium));
                    rayPayload.outerIorId = int16_t(peekId());
                    pushId(int(rayPayload.currentMedium));
                }
            }
            //mipLodMetallicRoughness = 0.0f;
            //mipLodColor = 0.0f;

        }

        lightSum += rayPayload.accumulation;
    }


    vec3 finalLight = lightSum / NUM_SAMPLES_PER_PIXEL;
    imageStore(storageImage, pixelCoords, vec4(finalLight, 1.0));
}