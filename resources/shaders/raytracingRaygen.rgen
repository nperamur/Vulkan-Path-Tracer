#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) uniform sampler2D depthBuffer;
layout(set = 0, binding = 2) uniform sampler2D visibilityBuffer;
layout(set = 0, binding = 4) uniform sampler2D[] baseColorTextures;
layout(set = 0, binding = 5, rgba32f) uniform image2D storageImage;
layout(set = 0, binding = 3) uniform sampler2D normalBuffer;
struct RayPayload {
    float distance;
    uint materialIndex;
    uint primitiveIndex;
    vec2 uv;
};

layout(push_constant) uniform PushConstants {
    uint frameCount;
} pushConstants;

layout(set = 1, binding = 0) uniform LightUBO {
    vec4 position;
    vec4 color;
    vec4 playerPos;
    int frameCount;
} lightData;


layout(buffer_reference, std430) buffer VertexBuffer {
    float data[];
};

layout(buffer_reference, std430) buffer IndexBuffer {
    uint data[];
};

layout(buffer_reference, std430) buffer NormalBuffer {
    float data[];
};

//TODO: if ref address is 0 it doesnt exist otherwise it exists
layout(buffer_reference, std430) buffer TextureCoordsBuffer {
    float data[];
};

uint nextRand(inout uint randState) {
    randState ^= randState << 13;
    randState ^= randState >> 17;
    randState ^= randState << 5;
    return randState;
}

float randFloat(inout uint randState) {
    return float(nextRand(randState) & 0x007fffffU) / float(0x00800000U);
}

vec2 randFloat2(inout uint randState) {
    float r1 = randFloat(randState);
    float r2 = randFloat(randState);
    return vec2(r1, r2);
}

uint initRandState(ivec2 pixelCoords, uint frameCount) {
    uint x = uint(pixelCoords.x);
    uint y = uint(pixelCoords.y);
    uint h = x ^ (y * 0x9e3779b9U) ^ (frameCount * 0x85ebca6bU);
    h ^= h >> 16;
    h *= 0x7feb352dU;
    h ^= h >> 15;
    h *= 0x846ca68bU;
    h ^= h >> 16;
    if (h == 0u) h = 1u;
    return h;
}


struct Material {
    vec4 color;
    mat4 modelMatrix;
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint64_t normalAddress;
    uint64_t textureCoordsAddress;
    float roughness;
    float metalness;
    float reflectivity;
    float albedoFactor;
    int lightIndex;
    int baseColorIndex;
};

struct Light {
    vec3 emissionFactor;
    int triangleCDFStartIndex;
    vec3 position;
    int triangleCDFStride;
    int materialIndex;
    float lightArea;
    float radius;
};


layout(std430, set = 0, binding = 6) buffer Materials {
    Material materialData[];
} materials;

layout(std430, set = 0, binding = 7) buffer TriangleCDFBuffer {
    float data[];
} triangleCDF;

layout(std430, set = 0, binding = 8) buffer LightCDFBuffer {
    float data[];
} lightCDF;

layout(std430, set = 0, binding = 9) buffer LightDataBuffer {
    uint lightCount;
    Light data[];
} lightDataBuffer;

layout(std430, set = 0, binding = 10) buffer EmissiveVerticesBuffer {
    float data[];
} emissiveVertices;

layout(set = 1, binding = 1) uniform InverseViewProj {
    mat4 invViewMatrix;
    mat4 invProjMatrix;
} inverseViewProj;

layout(location = 0) rayPayloadEXT RayPayload rayPayload;

const float PI = 3.14159265359;
const float directionalLightAngularRadius = 0.00465;

//TODO: give sun ratio relative to other weights
const float SUN_ANGLE_WEIGHT_MULTIPLIER = 10000;
const float SUN_WEIGHT_RATIO = 0.5f;
const float SUN_RADIENCE = 3e3;

//float u, float[] cdfBuffer int start, int end, int index, float pdf
#define SAMPLE_CDF(u, cdfBuffer, start, end, index, pdf) { \
    while (start < end) { \
        int mid = (start + end) / 2; \
        if (u > cdfBuffer[mid]) { \
            start = mid + 1; \
        } else { \
            end = mid; \
        } \
    } \
    index = start; \
    pdf = cdfBuffer[index] - (index > 0 ? cdfBuffer[index - 1] : 0.0); \
}

//returns the solid angle.
float sampleBoundingSphere(float boundingRadius, float distance) {
    if (distance <= boundingRadius) {
        return 2.0 * PI;
    }
    return 2 * PI * (1 - sqrt(1 - pow(boundingRadius, 2) / pow(distance, 2)));
}

float calculateSolidAngleFromAngularRadius(float radius) {
    float cosAlpha = cos(radius);
    float solidAngle = 2.0 * PI * (1.0 - cosAlpha);
    return solidAngle;
}

vec3 sampleDirectionalLight(vec3 centerDir, float cosThetaMax, uint randState) {
    float u1 = randFloat(randState);
    float u2 = randFloat(randState);

    float cosTheta = 1.0 - u1 * (1.0 - cosThetaMax);
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    float phi = 2.0 * PI * u2;
    vec3 localDir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    vec3 up = abs(centerDir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, centerDir));
    vec3 bitangent = cross(centerDir, tangent);

    return normalize(tangent * localDir.x + bitangent * localDir.y + centerDir * localDir.z);
}

float getSolidAnglePDF(Light light, vec3 lightDirection, vec3 lightPosition, vec3 surfacePos, vec3 lightNormal) {
    float pdfArea = 1 / light.lightArea;
    float cosTheta = max(abs(dot(lightDirection, lightNormal)), 0.0001);
    return pdfArea * pow(length(lightPosition - surfacePos), 2) / cosTheta;
}

vec3 sampleLight(inout uint randState, vec3 surfacePos, inout float lightDirectionPDF, inout vec3 emissionColor, inout float tMax, inout int materialIndex)  {
    float lightCDFRand = randFloat(randState);
    bool includesDirectionalLight = length(lightData.color) > 0;
    int start = 0;
    //int end = lightCDF.data.length();
    int lightIndex = 0;
    float lightSelectionPDF = 0;

    float solidAngleSum = 0;
    for (int i = 0; i < lightDataBuffer.lightCount; i++) {
        float dist = length(surfacePos - lightDataBuffer.data[i].position);
        float solidAngle = sampleBoundingSphere(lightDataBuffer.data[i].radius, dist);
        solidAngleSum += solidAngle;
    }
    float directionalLightSolidAngle = SUN_ANGLE_WEIGHT_MULTIPLIER * calculateSolidAngleFromAngularRadius(directionalLightAngularRadius);
    if (includesDirectionalLight) {
        solidAngleSum += directionalLightSolidAngle;
    }

    float lightSelectionCDFWeightCounter = 0;
    float chosenSolidAngle = -1;
    for (int i = 0; i < lightDataBuffer.lightCount; i++) {
        float dist = length(surfacePos - lightDataBuffer.data[i].position);
        float solidAngle = sampleBoundingSphere(lightDataBuffer.data[i].radius, dist);
        float cdfWeight = lightSelectionCDFWeightCounter + solidAngle / solidAngleSum;
        if (cdfWeight >= lightCDFRand && chosenSolidAngle < 0) {
            lightIndex = i;
            chosenSolidAngle = solidAngle / solidAngleSum;
        }
        lightSelectionCDFWeightCounter = cdfWeight;
    }

    if (includesDirectionalLight) {
        float normalizedDirectionalSolidAngle = directionalLightSolidAngle / solidAngleSum;
        float cdfWeight = lightSelectionCDFWeightCounter + normalizedDirectionalSolidAngle;
        if (cdfWeight >= lightCDFRand && chosenSolidAngle < 0) {
            lightIndex = -1;
            chosenSolidAngle = directionalLightSolidAngle / solidAngleSum;
        }
        lightSelectionCDFWeightCounter = cdfWeight;
    }
    lightSelectionPDF = chosenSolidAngle;
    if (lightIndex == -1) {
        emissionColor = SUN_RADIENCE * lightData.color.rgb;
        materialIndex = -1;
        lightDirectionPDF = (1 / calculateSolidAngleFromAngularRadius(directionalLightAngularRadius)) * lightSelectionPDF;
        return sampleDirectionalLight(normalize(lightData.position).xyz, cos(directionalLightAngularRadius), randState);
    }
    Light light = lightDataBuffer.data[lightIndex];

    start = light.triangleCDFStartIndex;
    int end = start + light.triangleCDFStride;
    float trianglePDF = 0;
    float triangleCDFRand = randFloat(randState);
    int triangleCDFIndex = 0;
    SAMPLE_CDF(triangleCDFRand, triangleCDF.data, start, end, triangleCDFIndex, trianglePDF);

    int triangleBufferStartIndex = triangleCDFIndex * 9;

    Material material = materials.materialData[light.materialIndex];

    vec3 v0 = (vec3(emissiveVertices.data[triangleBufferStartIndex], emissiveVertices.data[triangleBufferStartIndex + 1], emissiveVertices.data[triangleBufferStartIndex + 2]));
    vec3 v1 = (vec3(emissiveVertices.data[triangleBufferStartIndex + 3], emissiveVertices.data[triangleBufferStartIndex + 4], emissiveVertices.data[triangleBufferStartIndex + 5]));
    vec3 v2 = (vec3(emissiveVertices.data[triangleBufferStartIndex + 6], emissiveVertices.data[triangleBufferStartIndex + 7], emissiveVertices.data[triangleBufferStartIndex + 8]));

    float r1 = randFloat(randState);
    float r2 = randFloat(randState);
    float u = 1.0 - sqrt(r1);
    float v = r2 * sqrt(r1);

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 lightPosition = (v0 + (u * edge1) + (v * edge2));

    vec3 lightDirection = normalize(lightPosition - surfacePos);
    tMax = length(lightPosition - surfacePos);
    vec3 lightNormal = normalize(cross(edge1, edge2));
    float solidAnglePDF = getSolidAnglePDF(light, lightDirection, lightPosition, surfacePos, lightNormal);
    lightDirectionPDF = lightSelectionPDF * solidAnglePDF;
    emissionColor = materials.materialData[light.materialIndex].color.rgb * light.emissionFactor;
    materialIndex = light.materialIndex;
    return lightDirection;

}

//BRDF Calculation
vec3 getDiffuseBRDF(vec3 surfaceColor) {
    return surfaceColor / PI;
}

vec3 getSurfaceColor(Material material, vec2 uv, uint primitiveIndex) {
    if (material.baseColorIndex < 0 || material.textureCoordsAddress <= 0 || material.indexAddress <= 0) {
        return material.color.rgb * material.albedoFactor;
    }

    TextureCoordsBuffer textureCoords = TextureCoordsBuffer(material.textureCoordsAddress);
    IndexBuffer indices = IndexBuffer(material.indexAddress);
    uint i0 = indices.data[primitiveIndex * 3 + 0];
    uint i1 = indices.data[primitiveIndex * 3 + 1];
    uint i2 = indices.data[primitiveIndex * 3 + 2];
    vec2 t0 = vec2(textureCoords.data[i0*2+0], textureCoords.data[i0*2+1]);
    vec2 t1 = vec2(textureCoords.data[i1*2+0], textureCoords.data[i1*2+1]);
    vec2 t2 = vec2(textureCoords.data[i2*2+0], textureCoords.data[i2*2+1]);

    float x = 1.0f - uv.x - uv.y;

    vec2 texCoords = t0 * x + t1 * uv.x + t2 * uv.y;
    vec3 color = texture(baseColorTextures[nonuniformEXT(material.baseColorIndex)], texCoords).rgb * material.color.rgb;
    return color * material.albedoFactor;

}


void buildOrthonormalBasis(vec3 n, out vec3 t, out vec3 b) {
    if (n.y < -0.999999) {
        t = vec3(-1, 0, 0);
        b = vec3(0, 0, -1);
        return;
    }
    float a = 1.0 / (1.0 + n.y);
    float d = -n.x * n.z * a;
    t = vec3(1.0 - n.x * n.x * a, -n.x, d);
    b = vec3(d, -n.z, 1.0 - n.z * n.z * a);
}

vec3 getRandomDiffuseRayDir(vec2 rand, vec3 normal) {
    float r = sqrt(rand.x);
    float theta = 2 * PI * rand.y;

    //converting to polar
    float x = r * sin(theta);
    float y = r * cos(theta);
    float z = sqrt(max(1 - rand.x, 0.0));

    vec3 localVec = vec3(x, y, z);

    vec3 tangent;
    vec3 bitangent;
    buildOrthonormalBasis(normal, tangent, bitangent);
    mat3 tbn = mat3(tangent, bitangent, normal);

    return tbn * localVec;

}

// VNDF GGX sampling
// Source: https://community.intel.com/t5/Blogs/Tech-Innovation/Artificial-Intelligence-AI/VNDF-importance-sampling-for-an-isotropic-Smith-GGX-distribution/post/1599836
// u: random params, wi: incoming ray direction, n: surface normal
// returns microfacet normal
vec3 SampleVndf_GGX(vec2 u, vec3 wi, float alpha, vec3 n)
{
    alpha = max(alpha, 1e-5);

    // decompose the vector in parallel and perpendicular components
    vec3 wi_z = n * dot(wi, n);
    vec3 wi_xy = wi - wi_z;

    // warp to the hemisphere configuration
    vec3 warpTarget = wi_z - alpha * wi_xy;
    if (dot(warpTarget, warpTarget) < 1e-6) warpTarget += n * 1e-5;
    vec3 wiStd = normalize(warpTarget);

    // sample a spherical cap in (-wiStd.z, 1]
    float wiStd_z = dot(wiStd, n);
    float phi = (2.0f * u.x - 1.0f) * PI;
    float z = (1.0f - u.y) * (1.0f + wiStd_z) - wiStd_z;
    float sinTheta = sqrt(clamp(1.0f - z * z, 0.0f, 1.0f));
    float x = sinTheta * cos(phi);
    float y = sinTheta * sin(phi);
    vec3 cStd = vec3(x, y, z);

    // reflect sample to align with normal
    vec3 up = vec3(0, 0, 1);
    vec3 wr = n + up;
    if (abs(wr.z) < 1e-5) wr.z = 1e-5;
    vec3 c = dot(wr, cStd) * wr / wr.z - cStd;

    // compute halfway direction as standard normal
    vec3 wmStd = c + wiStd;
    vec3 wmStd_z = n * dot(n, wmStd);
    vec3 wmStd_xy = wmStd_z - wmStd;

    // warp back to the ellipsoid configuration
    vec3 finalWarp = wmStd_z + alpha * wmStd_xy;
    if (dot(finalWarp, finalWarp) < 1e-6) finalWarp += n * 1e-5;
    vec3 wm = normalize(finalWarp);

    // return final normal
    return wm;
}

float sampleGGXNormalDistributionFunction(float alpha, vec3 normal, vec3 halfVector) {
    float alpha2 = alpha * alpha;
    float NdotH = max(dot(normal, halfVector), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = NdotH2 * (alpha2 - 1.0) + 1.0;
    if (denom <= 0.0) return 0.0;
    return alpha2 / (PI * denom * denom);
}


float sampleGGXGeometry(float alpha, vec3 normal, vec3 dir) {
    float NdotV = max(dot(normal, dir), 0.0);
    float alpha2 = alpha * alpha;

    float denom = NdotV + sqrt(alpha2 + (1.0 - alpha2) * (NdotV * NdotV));
    return denom > 0.0 ? (2.0 * NdotV) / denom : 0.0;
}


float getGGXGeometry(float alpha, vec3 normal, vec3 view, vec3 lightDir) {
    return sampleGGXGeometry(alpha, normal, view) * sampleGGXGeometry(alpha, normal, lightDir);
}

vec3 fresnelSchlick(vec3 normal, vec3 view, vec3 f0) {
    return f0 + (1.0 - f0) * pow(clamp(1.0 - dot(normal, view), 0.0, 1.0), 5.0);
}

float getSolidAngleSum(vec3 surfacePos) {
    float solidAngleSum = 0.0;
    for (int i = 0; i < lightDataBuffer.lightCount; i++) {
        float dist = length(surfacePos - lightDataBuffer.data[i].position);
        solidAngleSum += sampleBoundingSphere(lightDataBuffer.data[i].radius, dist);
    }
    if (length(lightData.color) > 0) {
        solidAngleSum += SUN_ANGLE_WEIGHT_MULTIPLIER * calculateSolidAngleFromAngularRadius(directionalLightAngularRadius);
    }
    return solidAngleSum;
}

vec3 getSpecularBRDF(Material material, vec3 surfaceColor, vec3 normal, vec3 microfacetNormal, vec3 view, vec3 lightDir) {
    normal = normalize(normal);
    lightDir = normalize(lightDir);
    microfacetNormal = normalize(microfacetNormal);
    vec3 f0 = mix(vec3(material.reflectivity), surfaceColor, material.metalness);
    view = normalize(view);
    return (sampleGGXNormalDistributionFunction(material.roughness, normal, microfacetNormal)
            * getGGXGeometry(material.roughness, normal, view, lightDir) * fresnelSchlick(microfacetNormal, view, f0))
            / (max((4.0 * clamp(dot(normal, lightDir), 0, 1)) * clamp(dot(normal, view), 0, 1), 0.0001));
}

float getFresnelValue(Material material, vec3 surfaceColor, vec3 normal, vec3 incomingLight) {
    vec3 f0 = mix(vec3(material.reflectivity), surfaceColor, material.metalness);
    vec3 fresnel = fresnelSchlick(normal, incomingLight, f0);
    float fresnelValue = clamp((fresnel.x + fresnel.y + fresnel.z) / 3.0, 0.0, 1.0);
    return fresnelValue;
}

bool isDiffuseBounce(inout uint randState, vec3 microfacetNormal, vec3 incomingLight, Material material, vec3 surfaceColor) {
    float fresnelValue = mix(getFresnelValue(material, surfaceColor, microfacetNormal, incomingLight), 1.0, material.metalness);
    float rand = randFloat(randState);
    return (rand >= fresnelValue);
}





float getGGX_VNDF_PDF(Material material, vec3 normal, vec3 view, vec3 rayDir)
{
    normal = normalize(normal);
    view = normalize(view);
    rayDir = normalize(rayDir);

    float NdotV = dot(normal, view);
    float NdotL = dot(normal, rayDir);
    if (NdotV <= 0.0 || NdotL <= 0.0)
        return 0.0;

    vec3 h = normalize(view + rayDir);
    if (dot(view, h) <= 0.0)
        return 0.0;

    float alpha = material.roughness;
    float D = sampleGGXNormalDistributionFunction(alpha, normal, h);
    float G1 = sampleGGXGeometry(alpha, normal, view);

    return D * G1 / max(4.0 * NdotV, 1e-4);
}

const int NUM_SAMPLES_PER_PIXEL = 1;
const bool INTERPOLATED_NORMALS = true;
const int NUM_MAX_BOUNCES = 4;
const float lightIntensity = 50;
//const vec3 skyColor = vec3(0.4, 0.45, 0.9);
const vec3 skyColor = vec3(0, 0, 0);

void processBounce(
    vec3 normal,
    Material material,
    vec3 surfaceColor,
    vec3 prevRayDir,
    inout uint randState,
    bool shadowMiss,
    inout vec3 throughput,
    inout vec3 accumulatedLight,
    inout vec3 rayDir,
    vec3 lightDir,
    vec3 emissionColor,
    float lightDirectionPDF,
    bool mis,
    bool russianRoulette,
    inout float bsdfPDF
) {
    vec3 microfacetNormal = SampleVndf_GGX(randFloat2(randState), -prevRayDir, material.roughness, normal);
    bool diffuseBounce = isDiffuseBounce(randState, microfacetNormal, -prevRayDir, material, surfaceColor);

    vec3 directBRDF = vec3(0.0);
    vec3 directLight = vec3(0.0);

    if (diffuseBounce) {
        rayDir = normalize(getRandomDiffuseRayDir(randFloat2(randState), normal));
    } else {
        vec3 reflected = reflect(prevRayDir, microfacetNormal);
        float lenSq = dot(reflected, reflected);
        rayDir = (lenSq > 1e-6) ? (reflected * inversesqrt(lenSq)) : reflect(prevRayDir, normal);
    }

    vec3 directMicrofacetNormal = normalize(-prevRayDir + normalize(lightDir));
    vec3 f0 = mix(vec3(material.reflectivity), surfaceColor, material.metalness);
    vec3 fresnel = fresnelSchlick(normal, -prevRayDir, f0);
    vec3 specularBRDF = getSpecularBRDF(material, surfaceColor, normal, directMicrofacetNormal, -prevRayDir, normalize(lightDir));
    directBRDF = getSpecularBRDF(material, surfaceColor, normal, directMicrofacetNormal, -prevRayDir, normalize(lightDir)) +
                    getDiffuseBRDF(surfaceColor) * (1.0 - fresnelSchlick(directMicrofacetNormal, -prevRayDir, f0)) * (1.0 - material.metalness);


    float pdfDiffuse  = max(dot(normal, rayDir), 0.0) / PI;
    float pdfSpecular = getGGX_VNDF_PDF(material, normal, -prevRayDir, rayDir);

    float specularProb = mix(getFresnelValue(material, surfaceColor, microfacetNormal, -prevRayDir), 1.0, material.metalness);

    float fullPdf = ((1.0 - specularProb) * pdfDiffuse) + (specularProb * pdfSpecular);
    fullPdf = max(fullPdf, 1e-6);
    float misWeight = 1.0f;
    if (mis) {
        misWeight = lightDirectionPDF / (fullPdf + lightDirectionPDF);
    }
    bsdfPDF = fullPdf;

    if (shadowMiss) {
        directLight = directBRDF * max(0, dot(normal, normalize(lightDir))) * lightIntensity * emissionColor * misWeight / lightDirectionPDF;
    }
    if (dot(rayDir, normal) <= 0.0) { throughput = vec3(0.0f); return; }

    if (material.roughness == 0 && !diffuseBounce)  {
        throughput *= (fresnelSchlick(normal, -prevRayDir, f0))
                        / specularProb;
        return;
    }
    accumulatedLight += directLight * throughput;
    if (diffuseBounce) {
        throughput *= getDiffuseBRDF(surfaceColor)
                      * (1.0 - fresnelSchlick(microfacetNormal, -prevRayDir, f0))
                      * (1.0 - material.metalness)
                      * max(dot(normal, rayDir), 0.0)
                      / fullPdf;
    } else {
        throughput *= (getSpecularBRDF(material, surfaceColor, normal, microfacetNormal, -prevRayDir, rayDir)
                      * max(dot(normal, rayDir), 0.0))
                      / fullPdf;
    }

    if (russianRoulette) {
        float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
        if (randFloat(randState) >= p) {
            throughput = vec3(0);
            return;
        }
        throughput /= p;
    }
}

vec3 rayTriangleIntersect(vec3 v0, vec3 v1, vec3 v2, vec3 origin, vec3 rayDir, inout float u, inout float v, inout float t) {
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;

    vec3 rayCrossEdge2 = cross(rayDir, edge2);
    float det = dot(edge1, rayCrossEdge2);

    float invDet = 1.0f / det;
    vec3 s = origin - v0;
    u = invDet * dot(s, rayCrossEdge2);

    vec3 sCrossEdge1 = cross(s, edge1);
    v = invDet * dot(rayDir, sCrossEdge1);
    t = invDet * dot(edge2, sCrossEdge1);
    return origin + rayDir * t;
}

vec3 getInterpolatedNormal(vec3 origin, vec3 v0, vec3 v1, vec3 v2, vec3 n0, vec3 n1, vec3 n2, vec3 rayDir) {
    vec3 ep = origin - v0;
    vec3 e0 = v1 - v0;
    vec3 e1 = v2 - v0;
    float d00 = dot(e0, e0);
    float d01 = dot(e0, e1);
    float d11 = dot(e1, e1);
    float d20 = dot(ep, e0);
    float d21 = dot(ep, e1);
    float denom = d00 * d11 - d01 * d01;
    float u = (d11 * d20 - d01 * d21) / denom;
    float v = (d00 * d21 - d01 * d20) / denom;
    float w = 1.0 - u - v;
    vec3 normal = normalize(w * n0 + u * n1 + v * n2);
    if (dot(normal, -rayDir) < 0.0) normal = -normal;
    return normal;
}

vec3 calculateFaceNormal(uint primitiveIndex, vec3 rayDir, Material material) {
    VertexBuffer vertices = VertexBuffer(material.vertexAddress);
    IndexBuffer indices = IndexBuffer(material.indexAddress);
    uint i0 = indices.data[rayPayload.primitiveIndex * 3 + 0];
    uint i1 = indices.data[rayPayload.primitiveIndex * 3 + 1];
    uint i2 = indices.data[rayPayload.primitiveIndex * 3 + 2];
    vec3 v0 = (material.modelMatrix * vec4(vertices.data[i0*3+0], vertices.data[i0*3+1], vertices.data[i0*3+2], 1.0)).xyz;
    vec3 v1 = (material.modelMatrix * vec4(vertices.data[i1*3+0], vertices.data[i1*3+1], vertices.data[i1*3+2], 1.0)).xyz;
    vec3 v2 = (material.modelMatrix * vec4(vertices.data[i2*3+0], vertices.data[i2*3+1], vertices.data[i2*3+2], 1.0)).xyz;
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 normal = normalize(cross(e1, e2));
    if (dot(normal, -rayDir) < 0.0) normal = -normal;
    return normal;
}

 void main() {
     const ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
     vec3 lightSum = vec3(0.0);
     vec3 cameraPosition = lightData.playerPos.xyz;
     for (int n = 0; n < NUM_SAMPLES_PER_PIXEL; n++) {
         vec3 accumulatedLight = vec3(0.0);
         float tMin = 0.001;
         float tMax = 1000.0f;

         rayPayload.distance = -1.0f;
         rayPayload.materialIndex = 0;

         vec3 visibility = texelFetch(visibilityBuffer, pixelCoords, 0).rgb;
         uint randState = initRandState(pixelCoords, pushConstants.frameCount + uint(n * 97));

         if (visibility.b < 0.0001) {
             lightSum += skyColor;
             continue;
         }
         Material material = materials.materialData[int(visibility.r)];
         uint primitiveIndex = uint(visibility.g);
         VertexBuffer vertices = VertexBuffer(material.vertexAddress);
         IndexBuffer indices = IndexBuffer(material.indexAddress);
         NormalBuffer normals = NormalBuffer(material.normalAddress);
         uint i0 = indices.data[primitiveIndex * 3 + 0];
         uint i1 = indices.data[primitiveIndex * 3 + 1];
         uint i2 = indices.data[primitiveIndex * 3 + 2];
         vec3 v0 = (material.modelMatrix * vec4(vertices.data[i0*3+0], vertices.data[i0*3+1], vertices.data[i0*3+2], 1.0)).xyz;
         vec3 v1 = (material.modelMatrix * vec4(vertices.data[i1*3+0], vertices.data[i1*3+1], vertices.data[i1*3+2], 1.0)).xyz;
         vec3 v2 = (material.modelMatrix * vec4(vertices.data[i2*3+0], vertices.data[i2*3+1], vertices.data[i2*3+2], 1.0)).xyz;
         vec2 jitter = randFloat2(randState);
         vec2 uv = vec2(gl_LaunchIDEXT.xy + jitter) / vec2(gl_LaunchSizeEXT.xy);
         vec2 ndc = uv * 2.0 - 1.0;
         vec4 rayClip = vec4(ndc, 1.0, 1.0);
         vec4 rayDirWorld = inverseViewProj.invViewMatrix * (inverseViewProj.invProjMatrix * rayClip);
         vec3 rayDir = normalize(rayDirWorld.xyz / rayDirWorld.w - cameraPosition);

         vec3 normal = normalize(cross(v1 - v0, v2 - v0));
         if (dot(normal, -rayDir) < 0.0) normal = -normal;

         //float t = dot(v0 - cameraPosition, normal) / dot(rayDir, normal);
         //vec4 origin = vec4(cameraPosition + rayDir * t + normal * 0.0001, 1.0);
         float u = 0;
         float v = 0;
         float t = 0;
         vec4 origin = vec4(rayTriangleIntersect(v0, v1, v2, cameraPosition, rayDir, u, v, t), 1.0);

         vec3 throughput = vec3(1.0);
         vec3 view = rayDirWorld.xyz / rayDirWorld.w;
         rayPayload.distance = -1.0f;

         if (material.lightIndex >= 0) {
             Light light = lightDataBuffer.data[material.lightIndex];
             lightSum += vec3(light.emissionFactor * materials.materialData[light.materialIndex].color.rgb) * lightIntensity;
             continue;
         }

         vec3 emissionColor;
         float lightDirectionPDF;
         int lightMaterialIndex;
         float lightDist = -1.0f;
         float bsdfPDF = 0.0f;

         vec3 lightDir = sampleLight(randState, origin.xyz, lightDirectionPDF, emissionColor, lightDist, lightMaterialIndex);
         if (lightDirectionPDF <= 0) continue;
         traceRayEXT(
             topLevelAS,
             gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
             0xFF,
             0,
             0,
             0,
             origin.xyz,
             tMin,
             lightDir,
             lightDist > 0 ? lightDist : tMax,
             0
         );

         vec3 prevRayDir = rayDir;
         rayDir = vec3(0.0);
         if (INTERPOLATED_NORMALS) {
             vec3 n0 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i0*3+0], normals.data[i0*3+1], normals.data[i0*3+2]));
             vec3 n1 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i1*3+0], normals.data[i1*3+1], normals.data[i1*3+2]));
             vec3 n2 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i2*3+0], normals.data[i2*3+1], normals.data[i2*3+2]));
             normal = getInterpolatedNormal(origin.xyz, v0, v1, v2, n0, n1, n2, prevRayDir);
         }
         processBounce(normal, material, getSurfaceColor(material, vec2(u, v), primitiveIndex), prevRayDir, randState,
                         rayPayload.distance < 0 || rayPayload.materialIndex == lightMaterialIndex,
                         throughput, accumulatedLight, rayDir, lightDir, emissionColor, lightDirectionPDF, false, false, bsdfPDF);

         if (dot(rayDir, normal) <= 0.0) throughput = vec3(0.0f);

         if (throughput == vec3(0)) {
            lightSum += accumulatedLight;
            continue;
         }
         for (int i = 0; i < NUM_MAX_BOUNCES; i++) {
             rayPayload.distance = -1.0f;
             bool mis = material.roughness != 0;
             traceRayEXT(
                 topLevelAS,
                 gl_RayFlagsOpaqueEXT,
                 0xFF,
                 0,
                 0,
                 0,
                 origin.xyz,
                 tMin,
                 rayDir,
                 tMax,
                 0
             );
             prevRayDir = rayDir;
             material = materials.materialData[rayPayload.materialIndex];
             primitiveIndex = rayPayload.primitiveIndex;
             normal = calculateFaceNormal(rayPayload.primitiveIndex, rayDir, material);
             uint materialIndex = rayPayload.materialIndex;
             vec3 prevOrigin = origin.xyz;
             origin = vec4(origin.xyz + rayDir * rayPayload.distance + normal * 0.0001, 1);
             vec2 uv = rayPayload.uv;
             if (INTERPOLATED_NORMALS) {
                vertices = VertexBuffer(material.vertexAddress);
                indices = IndexBuffer(material.indexAddress);
                normals = NormalBuffer(material.normalAddress);
                uint i0 = indices.data[rayPayload.primitiveIndex * 3 + 0];
                uint i1 = indices.data[rayPayload.primitiveIndex * 3 + 1];
                uint i2 = indices.data[rayPayload.primitiveIndex * 3 + 2];
                vec3 n0 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i0*3+0], normals.data[i0*3+1], normals.data[i0*3+2]));
                vec3 n1 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i1*3+0], normals.data[i1*3+1], normals.data[i1*3+2]));
                vec3 n2 = normalize(mat3(material.modelMatrix) * vec3(normals.data[i2*3+0], normals.data[i2*3+1], normals.data[i2*3+2]));
                v0 = (material.modelMatrix * vec4(vertices.data[i0*3+0], vertices.data[i0*3+1], vertices.data[i0*3+2], 1.0)).xyz;
                v1 = (material.modelMatrix * vec4(vertices.data[i1*3+0], vertices.data[i1*3+1], vertices.data[i1*3+2], 1.0)).xyz;
                v2 = (material.modelMatrix * vec4(vertices.data[i2*3+0], vertices.data[i2*3+1], vertices.data[i2*3+2], 1.0)).xyz;

                normal = getInterpolatedNormal(origin.xyz, v0, v1, v2, n0, n1, n2, prevRayDir);
             }

             if (material.lightIndex >= 0) {
                 Light light = lightDataBuffer.data[material.lightIndex];
                 float misWeight = 1.0f;
                 float dist = length(prevOrigin - light.position);
                 float lightSelectionPDF = sampleBoundingSphere(light.radius, dist) / getSolidAngleSum(prevOrigin);
                 float solidAnglePDF = getSolidAnglePDF(light, prevRayDir, origin.xyz, prevOrigin, normal);
                 float lightPDF = lightSelectionPDF * solidAnglePDF;
                 if (mis) {
                    misWeight = bsdfPDF / (bsdfPDF + lightPDF);
                 }
                 accumulatedLight += lightIntensity * light.emissionFactor * materials.materialData[light.materialIndex].color.rgb * throughput * misWeight;
                 break;
             }

             if (rayPayload.distance < 0) {
                  float cosDir = cos(directionalLightAngularRadius);
                  float sampleDiff = dot(rayDir, normalize(lightData.position).xyz);
                  float misWeight = 1.0f;
                  if (sampleDiff > cosDir && length(lightData.color.rgb) > 0) {
                      float directionalLightSolidAngleWeight = SUN_ANGLE_WEIGHT_MULTIPLIER * calculateSolidAngleFromAngularRadius(directionalLightAngularRadius) / getSolidAngleSum(prevOrigin);
                      float lightPDF = (1 / calculateSolidAngleFromAngularRadius(directionalLightAngularRadius)) * directionalLightSolidAngleWeight;
                      if (mis) {
                        misWeight = bsdfPDF / (bsdfPDF + lightPDF);
                      }
                      accumulatedLight += lightIntensity * lightData.color.rgb * throughput * misWeight;
                  } else {
                      accumulatedLight += skyColor * throughput;
                  }
                  break;
             }

             mis = material.roughness != 0;
             int lightMaterialIndex;
             lightDist = -1.0f;
             vec3 lightDir = sampleLight(randState, origin.xyz, lightDirectionPDF, emissionColor, lightDist, lightMaterialIndex);

             if (lightDirectionPDF <= 0) break;


            if (material.roughness != 0) {
                traceRayEXT(
                     topLevelAS,
                     gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                     0xFF,
                     0,
                     0,
                     0,
                     origin.xyz,
                     tMin,
                     lightDir,
                     lightDist > 0 ? lightDist : tMax,
                     0
                );
            }


             processBounce(normal, material, getSurfaceColor(material, uv, primitiveIndex), prevRayDir, randState,
                 material.roughness != 0 && (rayPayload.distance < 0 || rayPayload.materialIndex == lightMaterialIndex),
                 throughput, accumulatedLight, rayDir, lightDir, emissionColor, lightDirectionPDF, material.roughness != 0, i >= 2, bsdfPDF);

             if (throughput == vec3(0)) {
                break;
             }
         }

         lightSum += accumulatedLight;
     }

     vec3 finalLight = lightSum / NUM_SAMPLES_PER_PIXEL;
     imageStore(storageImage, pixelCoords, vec4(finalLight, 1.0));
 }